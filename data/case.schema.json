{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fde-atlas:case.schema.json",
  "title": "FDE Atlas Case",
  "description": "企业 AI 落地案例的单一事实结构。注意：detail_* 与 evidence_label 均为派生字段，由构建期评分引擎计算，不允许出现在本文件中。directness 与 evidence_level 必须一致（校验层强制）。",
  "type": "array",
  "items": { "$ref": "#/$defs/case" },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "case": {
      "type": "object",
      "required": [
        "id", "source", "company", "industry", "industry_group", "scenario",
        "fde", "fde_relation", "problem", "solution", "human", "result",
        "maturity", "maturity_stage", "url", "architecture", "components",
        "fde_actions", "reusable", "evidence", "case_summary", "evidence_level",
        "source_record", "analysis_boundary",
        "verification_notes", "additional_sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "稳定案例 ID，格式为 <来源前缀>-<三位序号>"
        },
        "technical_reference": {
          "type": "boolean",
          "description": "是否可作为技术方案参考。由 validate.mjs 的交叉规则强制：true 时 technical_workflow 必须满分"
        },
        "source": { "type": "string", "minLength": 1 },
        "company": { "type": "string", "minLength": 1 },
        "industry": { "type": "string", "minLength": 1 },
        "industry_group": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 2 },
        "fde": { "type": "string", "minLength": 1 },
        "fde_relation": { "type": "string", "minLength": 1 },
        "problem": { "type": "string", "minLength": 10 },
        "solution": { "type": "string", "minLength": 20 },
        "human": { "type": "string", "minLength": 10 },
        "result": { "type": "string", "minLength": 10 },
        "maturity": { "type": "string", "minLength": 1 },
        "maturity_stage": {
          "type": "string",
          "description": "受控词表，见 src/core/taxonomy.js 的 MATURITY_STAGES"
        },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "architecture": { "$ref": "#/$defs/nonEmptyStrings" },
        "components": { "$ref": "#/$defs/nonEmptyStrings" },
        "fde_actions": { "$ref": "#/$defs/nonEmptyStrings" },
        "reusable": { "$ref": "#/$defs/nonEmptyStrings" },
        "evidence": { "type": "string", "minLength": 1 },
        "case_summary": { "type": "string", "minLength": 30 },
        "evidence_level": {
          "enum": ["A", "B", "C", "D"],
          "description": "A=案例级直接来源 B=官方汇总来源 C=可信二次材料 D=线索待核验"
        },
        "source_record": {
          "type": "object",
          "required": [
            "title", "publisher", "url", "source_type", "directness",
            "claim_origin", "independently_verified", "accessed_at"
          ],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "publisher": { "type": "string", "minLength": 1 },
            "url": { "$ref": "#/$defs/httpsUrl" },
            "source_type": {
              "type": "string",
              "minLength": 1,
              "description": "来源的具体类型（厂商客户案例 / 企业年度报告 / 学术论文 ...），承载编辑补充的来源细节"
            },
            "directness": {
              "enum": ["case_level", "company_level", "aggregate", "secondary", "lead"],
              "description": "语言中立的来源直接性枚举。标签在 i18n 层解析（DIRECTNESS_ZH / DIRECTNESS_EN）。与 evidence_level 必须一致，由 validate.mjs 交叉校验强制"
            },
            "claim_origin": { "type": "string", "minLength": 1 },
            "independently_verified": {
              "type": "boolean",
              "description": "仅当存在财报/监管/学术/第三方审计材料时才可为 true"
            },
            "accessed_at": { "$ref": "#/$defs/isoDate" },
            "collection_title": {
              "type": "string",
              "minLength": 1,
              "description": "案例所属的官方合集名称，用于多案例汇总来源的定位"
            },
            "case_number": {
              "type": "integer",
              "minimum": 1,
              "description": "案例在官方合集中的序号"
            },
            "pdf_page": { "type": "integer", "minimum": 1 },
            "printed_page": { "type": "integer", "minimum": 1 },
            "archived_url": { "$ref": "#/$defs/httpsUrl" }
          },
          "additionalProperties": false
        },
        "analysis_boundary": {
          "type": "object",
          "description": "逐字段标注该内容是公开披露、结构化整理还是编辑推演",
          "required": ["business_problem", "solution", "architecture", "fde_actions", "result"],
          "properties": {
            "business_problem": { "type": "string", "minLength": 1 },
            "solution": { "type": "string", "minLength": 1 },
            "architecture": { "type": "string", "minLength": 1 },
            "fde_actions": { "type": "string", "minLength": 1 },
            "result": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "verification_notes": { "$ref": "#/$defs/nonEmptyStrings" },
        "additional_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "url": { "$ref": "#/$defs/httpsUrl" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}